{
  "name": "concord",
  "version": "0.1.31",
  "description": "Chat de texto e voz estilo Discord, feito com Electron + React + shadcn/ui",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:all": "concurrently -k -n server,app -c cyan,magenta \"npm run server\" \"npm run dev\"",
    "dev": "electron-vite dev",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:import-json": "tsx server/scripts/import-json.ts",
    "db:restore": "tsx server/scripts/restore-pglite.ts"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@ui-sdk/core": "0.1.0-beta.10",
    "@ui-sdk/react": "0.1.0-beta.10",
    "electron-updater": "6.8.12",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@livekit/rtc-node": "^1.2.2",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.16.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "jsdom": "^31.0.1",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^0.525.0",
    "music-metadata": "12.3.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.1.0",
    "zustand": "^5.0.6"
  }
}
