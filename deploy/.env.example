# Produção (A14): copie para .env na raiz do projeto (ao lado do docker-compose.prod.yml) e preencha.
# Gere segredos com:  openssl rand -hex 32

# Endereços (os dois apontando para o IP da máquina, registro DNS do tipo A)
CONCORD_DOMAIN=concord.exemplo.com.br
LIVEKIT_DOMAIN=voz.exemplo.com.br

# Banco: senha do dono (migrations e backup) e do usuário do app (privilégio mínimo)
POSTGRES_PASSWORD=troque-por-um-segredo-longo
APP_DB_PASSWORD=troque-por-outro-segredo-longo

# Links assinados de anexos e sons (sem isso eles param ao reiniciar o servidor)
FILES_SIGNING_SECRET=troque-por-um-segredo-longo

# LiveKit: a chave é um nome qualquer; o segredo precisa ter pelo menos 32 caracteres
LIVEKIT_API_KEY=concord
LIVEKIT_API_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Opcional: "Entrar com Google" (cliente OAuth do tipo "App para computador")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
