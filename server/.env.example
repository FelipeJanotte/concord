# Copie para server/.env e preencha para ativar "Entrar com Google".
# Crie um cliente OAuth do tipo "App para computador" no Google Cloud Console
# (APIs e serviços > Credenciais). É gratuito.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Infra local (docker compose up -d) ---------------------------------------
# Os valores abaixo batem com docker-compose.yml e livekit.yaml. Troque em produção.

# PostgreSQL. Sem DATABASE_URL (apague ou comente a linha), o servidor usa o PGlite
# (Postgres embutido, sem Docker) em DATA_DIR/pgdata — bom para quem só quer rodar.
DATABASE_URL=postgres://concord:concord@localhost:5432/concord
# Banco dos testes (vitest). Criado por docker/postgres/init/01-test-db.sql. Cada arquivo de
# teste cria e apaga um banco temporário a partir dele. Sem esta linha, os testes usam PGlite.
DATABASE_URL_TEST=postgres://concord:concord@localhost:5432/concord_test

# LiveKit (usado a partir da task B1). LIVEKIT_URL é o endereço que o APP usa;
# para outros PCs da rede, troque localhost pelo IP desta máquina.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=concord-dev
LIVEKIT_API_SECRET=concord-dev-secret-troque-em-producao
