{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Concord",
  "mainBinaryName": "concord",
  "version": "../package.json",
  "identifier": "com.concord.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/renderer",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "windows": { "staticVCRuntime": false }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Concord",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "decorations": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https: ipc: http://ipc.localhost",
        "media-src": "'self' blob: mediastream: http: https:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss: http: https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4MjNDM0EzNjIzOTUwRUEKUldUcVVEbGlvOE1qMkVCNHlmeVJQUDRNaU1TZXFsVVI3SVlhU1lVYU5tLzBtNmxvQm1jaG91dmwK",
      "endpoints": ["https://github.com/FelipeJanotte/concord/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "deep-link": { "desktop": { "schemes": ["concord"] } }
  }
}
